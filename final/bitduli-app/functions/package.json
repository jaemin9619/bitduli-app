{
  "name": "bitduli-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "node scripts/checkSyntax.js",
    "test": "node --test --test-isolation=none test/validation.test.js test/diaryFunctions.test.js",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --project demo-bitduli --only firestore \"node --test --test-isolation=none test/friendFunctions.emulator.test.js\"",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.28.2"
  }
}
