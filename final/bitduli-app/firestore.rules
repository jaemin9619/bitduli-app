rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUser(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    function isAcceptedFriend(ownerEmail) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(ownerEmail)/friends/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/users/$(ownerEmail)/friends/$(request.auth.token.email)).data.status == 'accepted';
    }

    match /users/{email} {
      allow read: if request.auth != null;
      allow create, update: if isUser(email)
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isUser(email);

      match /diaries/{date} {
        allow write: if isUser(email);
        allow read: if isUser(email) || (resource.data.isPublic == true && isAcceptedFriend(email));
      }

      match /friends/{friendEmail} {
        // The owner fully manages their own friends list.
        // Any other signed-in user may create/update/delete ONLY the doc that
        // represents themselves (doc id == their email AND data.friendEmail ==
        // their email). This supports the mutual friend-request / accept /
        // decline flow performed client-side without impersonating a third party.
        allow read: if isUser(email);
        allow create, update: if isUser(email)
          || (friendEmail == request.auth.token.email
              && request.resource.data.friendEmail == request.auth.token.email);
        allow delete: if isUser(email) || friendEmail == request.auth.token.email;
      }
    }

    match /aiUsage/{docId} {
      allow read, write: if false;
    }
  }
}
